<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Suowang.Widget</RootNamespace>
    <AssemblyName>Suowang.Widget</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WidBarPluginId>com.suowang.nextstep</WidBarPluginId>
    <WidBarPluginName>所往 · 下一步</WidBarPluginName>
    <WidBarPluginDescription>随手接续下一步，共用所往本地数据。</WidBarPluginDescription>
    <WidBarPluginCategory>Utility</WidBarPluginCategory>
    <WidBarPluginVersion>0.1.0</WidBarPluginVersion>
    <WidBarPluginPreviewWidth>180</WidBarPluginPreviewWidth>
    <WidBarPluginConfigurable>false</WidBarPluginConfigurable>
  </PropertyGroup>
  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="WidBar.SDK" Version="2.0.0" />
  </ItemGroup>
</Project>
